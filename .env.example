# Stardance mission bot tokens.
# Copy this file to .env and paste the real values. Never commit .env.

# Bot User OAuth Token from Slack, OAuth & Permissions page (starts with xoxb-)
SLACK_BOT_TOKEN=paste-your-bot-token-here

# Signing Secret from Slack, Basic Information page, App Credentials section
SLACK_SIGNING_SECRET=your-signing-secret-here

# App-Level Token from Slack, Basic Information page, App-Level Tokens section (starts with xapp-)
# Socket Mode needs this one.
SLACK_APP_TOKEN=paste-your-app-level-token-here
